<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmlTerminal.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="OmlAccent" Color="#38BDF8" />
    <SolidColorBrush x:Key="OmlSidebar" Color="#111418" />
    <SolidColorBrush x:Key="OmlSurface" Color="#0C0C0C" />
    <SolidColorBrush x:Key="OmlBorder" Color="#262B33" />
    <SolidColorBrush x:Key="OmlMuted" Color="#8B949E" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#38BDF8" RegionColor="#15181D" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <!-- Selection is a tint, not a solid accent fill: rows carry coloured status text that must stay readable. -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3338BDF8" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4438BDF8" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#3338BDF8" />
    </Style>
    <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#4438BDF8" />
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="#38BDF8" />
      <Setter Property="Opacity" Value="0.22" />
    </Style>
    <!-- Compact table headers: tool tables have many narrow numeric columns -->
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Padding" Value="8,0,0,0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource OmlMuted}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="{StaticResource OmlMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Styles>
</Application>
