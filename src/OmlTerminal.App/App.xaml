<Application
    x:Class="OmlTerminal.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="SystemAccentColor">#38BDF8</Color>
            <Color x:Key="SystemAccentColorLight1">#7DD3FC</Color>
            <Color x:Key="SystemAccentColorLight2">#BAE6FD</Color>
            <Color x:Key="SystemAccentColorLight3">#E0F2FE</Color>
            <Color x:Key="SystemAccentColorDark1">#0EA5E9</Color>
            <Color x:Key="SystemAccentColorDark2">#0284C7</Color>
            <Color x:Key="SystemAccentColorDark3">#0369A1</Color>

            <!-- Brand -->
            <Color x:Key="OmlOrange">#F97316</Color>
            <Color x:Key="OmlSky">#38BDF8</Color>
            <SolidColorBrush x:Key="OmlOrangeBrush" Color="#F97316" />
            <SolidColorBrush x:Key="OmlSkyBrush" Color="#38BDF8" />

            <!-- Surfaces - layered neutral black, each tier a touch lighter so panels actually read as separate -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#04060B" />
            <SolidColorBrush x:Key="PanelBrush" Color="#090D16" />
            <SolidColorBrush x:Key="CardBrush" Color="#0F1522" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#16203A" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#1C2638" />
            <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#070A10" />
            <SolidColorBrush x:Key="StatusBarBrush" Color="#04060B" />

            <!-- Tinted brand-color surfaces (formalizes what used to be inline alpha hex scattered across views) -->
            <SolidColorBrush x:Key="OmlOrangeSubtleBrush" Color="#26F97316" />
            <SolidColorBrush x:Key="OmlOrangeBorderBrush" Color="#66F97316" />
            <SolidColorBrush x:Key="OmlOrangeBorderSubtleBrush" Color="#55F97316" />
            <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#2038BDF8" />
            <SolidColorBrush x:Key="BadgeBorderBrush" Color="#5538BDF8" />

            <!-- Connection status - four distinct states. "Connecting" and "disconnected/error" were previously
                 collapsed onto the same orange, which made a session that was still handshaking look identical to
                 one that had failed; splitting them out matters for a tool whose whole job is showing link state. -->
            <SolidColorBrush x:Key="StatusConnectedBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="StatusConnectingBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="StatusErrorBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="StatusIdleBrush" Color="#64748B" />

            <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#F97316" Offset="0" />
                <GradientStop Color="#FB923C" Offset="0.35" />
                <GradientStop Color="#38BDF8" Offset="0.75" />
                <GradientStop Color="#7DD3FC" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="GlowBorderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#6638BDF8" Offset="0" />
                <GradientStop Color="#33A78BFA" Offset="0.5" />
                <GradientStop Color="#55F97316" Offset="1" />
            </LinearGradientBrush>

            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

            <!-- Two-tier corner radius scale: 12 for panels/cards/dialogs/buttons, 6 for small inline badges.
                 (Previously buttons drifted to a stray 10 and one dialog panel to 8 - collapsed into this.) -->
            <CornerRadius x:Key="CardRadius">12</CornerRadius>
            <CornerRadius x:Key="BadgeRadius">6</CornerRadius>

            <!-- Shared text roles, so "HOME" / "RECENT" / "MULTI-EXEC" / "MASTER PASSWORD" etc. stay visually
                 identical by construction instead of by four separate copies of the same five properties. -->
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="150" />
                <Setter Property="Foreground" Value="{StaticResource OmlOrangeBrush}" />
            </Style>
            <Style x:Key="HeroTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="48" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource BrandGradientBrush}" />
            </Style>
            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource BrandGradientBrush}" />
            </Style>
            <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- The "fake accent button" pattern (bare Button + hardcoded orange background/border) formalized as
                 a real, reusable style so every OML-branded action button is guaranteed identical. -->
            <Style x:Key="OmlAccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource OmlOrangeSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource OmlOrangeBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource OmlOrangeBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,10" />
            </Style>

            <!-- Small pill badge (protocol/console-type labels: SSH / RDP / VNC / TELNET etc.) - most usages give
                 this a fixed Width, so no default Padding here: adding any shrank the usable text area enough to
                 clip "TELNET" at 10px font. Where a usage has no fixed width (OmlLabTabView's console badge) it
                 sets its own Padding locally instead. -->
            <Style x:Key="BadgeBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BadgeBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BadgeBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource BadgeRadius}" />
            </Style>
            <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource OmlSkyBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Applied to every ContentDialog so they read as part of the same app instead of stock Fluent
                 chrome - matches the card surfaces/border/radius used everywhere else. -->
            <Style x:Key="AppContentDialogStyle" TargetType="ContentDialog">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlowBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
            </Style>

            <!-- Branded TabView/ListView theming via WinUI's own documented theme-resource keys (verified against
                 the actual shipped generic.xaml rather than guessed) instead of replacing control templates - far
                 lower risk than a full ControlTemplate rewrite of a control this central to the app, while still
                 giving every tab/list a cohesive, on-brand look instead of stock Fluent gray. -->
            <SolidColorBrush x:Key="TabViewBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#0F1522" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#16203A" />
            <SolidColorBrush x:Key="TabViewItemHeaderForeground" Color="#8B9BB4" />
            <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#F8FAFC" />
            <SolidColorBrush x:Key="TabViewItemHeaderForegroundPointerOver" Color="#F8FAFC" />
            <LinearGradientBrush x:Key="TabViewSelectedItemBorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,4">
                <LinearGradientBrush.RelativeTransform>
                    <ScaleTransform ScaleY="-1" CenterY="0.5" />
                </LinearGradientBrush.RelativeTransform>
                <LinearGradientBrush.GradientStops>
                    <GradientStop Offset="1.0" Color="Transparent" />
                    <GradientStop Offset="1.0" Color="#38BDF8" />
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>

            <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#111A2B" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#16203A" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#1C2945" />
            <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{StaticResource OmlSky}" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="{StaticResource OmlSky}" />

            <!-- Next-gen accents: violet and mint join the orange/sky brand pair for tool categories and live states. -->
            <SolidColorBrush x:Key="OmlVioletBrush" Color="#A78BFA" />
            <SolidColorBrush x:Key="OmlMintBrush" Color="#34D399" />
            <SolidColorBrush x:Key="OmlRoseBrush" Color="#FB7185" />
            <SolidColorBrush x:Key="OmlAmberBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="ToolbarBrush" Color="#070B13" />
            <SolidColorBrush x:Key="InputSurfaceBrush" Color="#0B111D" />

            <LinearGradientBrush x:Key="HeaderGlowBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0038BDF8" Offset="0" />
                <GradientStop Color="#8838BDF8" Offset="0.3" />
                <GradientStop Color="#88A78BFA" Offset="0.6" />
                <GradientStop Color="#00F97316" Offset="1" />
            </LinearGradientBrush>

            <!-- Icon-over-label ribbon button (MobaXterm-style toolbar, flattened and neon-lit). -->
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="MinWidth" Value="62" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="ToolbarLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="#B8C4D6" />
            </Style>
            <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Margin" Value="6,8" />
                <Setter Property="Background" Value="{StaticResource HairlineBrush}" />
            </Style>

            <!-- Tool pages: a titled card grid shared by every tool tab so they read as one product. -->
            <Style x:Key="ToolCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="ToolTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource BrandGradientBrush}" />
            </Style>
            <Style x:Key="MonoOutputStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="IsSpellCheckEnabled" Value="False" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Background" Value="{StaticResource TerminalBackgroundBrush}" />
            </Style>
            <Style x:Key="MonoInputStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="IsSpellCheckEnabled" Value="False" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
