<UserControl
    x:Class="OmlTerminal.App.Views.Tools.PortScanView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmlTerminal.App.Views.Tools">

    <Grid Padding="24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Port Query" Style="{StaticResource ToolTitleStyle}" />
            <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="13"
                       Text="PortQry / Test-NetConnection for the whole team: TCP connect or UDP probe, ranges and presets (common, web, mgmt, mail, db, windows), optional banner grab." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ToolCardStyle}">
            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="HostBox" Header="Target host" PlaceholderText="10.0.0.1 or fw01.corp.local"
                         FontFamily="{StaticResource MonoFont}" KeyDown="Input_KeyDown" />
                <TextBox x:Name="PortsBox" Grid.Column="1" Header="Ports" Text="common" PlaceholderText="22,443,8000-8010 or common"
                         FontFamily="{StaticResource MonoFont}" KeyDown="Input_KeyDown" />
                <ComboBox x:Name="ProtocolBox" Grid.Column="2" Header="Protocol" HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem Content="TCP" />
                    <ComboBoxItem Content="UDP" />
                    <ComboBoxItem Content="TCP + UDP" />
                </ComboBox>
                <NumberBox x:Name="TimeoutBox" Grid.Column="3" Header="Timeout (ms)" Value="1500" Minimum="100" Maximum="30000"
                           SpinButtonPlacementMode="Hidden" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button x:Name="ScanButton" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click" MinWidth="96" AutomationProperties.Name="Query">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                            <TextBlock Text="Query" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Click="Stop_Click" IsEnabled="False" ToolTipService.ToolTip="Stop" AutomationProperties.Name="Stop">
                        <FontIcon Glyph="&#xE71A;" FontSize="12" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="18">
                    <CheckBox x:Name="BannerBox" Content="Grab service banner" />
                    <CheckBox x:Name="ShowClosedBox" Content="Show closed / filtered" Click="Filter_Click" />
                    <Button Content="Copy CSV" Click="Copy_Click" />
                    <Button Content="Save CSV..." Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress" VerticalAlignment="Center" Maximum="1" Value="0" />
            <TextBlock x:Name="SummaryText" Grid.Column="1" FontSize="12" Opacity="0.8" FontFamily="{StaticResource MonoFont}" Text="Idle" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource ToolCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,10" ColumnSpacing="12" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PORT" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Grid.Column="1" Text="PROTO" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Grid.Column="2" Text="STATE" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Grid.Column="3" Text="SERVICE" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Grid.Column="4" Text="RTT" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Grid.Column="5" Text="BANNER" Style="{StaticResource SectionLabelStyle}" />
                </Grid>
                <ListView x:Name="ResultsList" Grid.Row="1" SelectionMode="Extended" Padding="4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PortRow">
                            <Grid ColumnSpacing="12" Padding="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Port}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Protocol}" Opacity="0.7" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="8" Height="8" Fill="{x:Bind StateBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind State}" Foreground="{x:Bind StateBrush}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{x:Bind Service}" Opacity="0.8" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Rtt}" FontFamily="{StaticResource MonoFont}" Opacity="0.7" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Banner}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           Opacity="0.75" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
