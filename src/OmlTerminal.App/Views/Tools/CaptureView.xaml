<UserControl
    x:Class="OmlTerminal.App.Views.Tools.CaptureView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Packet Capture" Style="{StaticResource ToolTitleStyle}" />
            <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="13" TextWrapping="Wrap"
                       Text="Run tcpdump on a Linux box or diagnose sniffer on a FortiGate over SSH, or capture on this PC with Wireshark's tshark. tcpdump can stream straight into a local .pcap for Wireshark." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ToolCardStyle}">
            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ComboBox x:Name="PlatformBox" Header="Capture on" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Changed">
                    <ComboBoxItem Content="Linux / tcpdump (SSH)" />
                    <ComboBoxItem Content="FortiGate sniffer (SSH)" />
                    <ComboBoxItem Content="This PC (tshark)" />
                </ComboBox>
                <ComboBox x:Name="DeviceBox" Grid.Column="1" Header="Device (saved SSH session)" HorizontalAlignment="Stretch"
                          PlaceholderText="Pick a saved SSH session" DisplayMemberPath="Display" SelectionChanged="Changed" />
                <ComboBox x:Name="InterfaceBox" Grid.Column="2" Header="Interface" HorizontalAlignment="Stretch" IsEditable="True"
                          Text="any" TextSubmitted="Interface_TextSubmitted" SelectionChanged="Changed" />
                <NumberBox x:Name="CountBox" Grid.Column="3" Header="Packets" Value="0" Minimum="0" Maximum="1000000"
                           SpinButtonPlacementMode="Hidden" ToolTipService.ToolTip="0 = until stopped" ValueChanged="Count_ValueChanged" />

                <TextBox x:Name="HostBox" Grid.Row="1" Header="Host / net" PlaceholderText="10.0.0.5, 10.1.0.0/16"
                         FontFamily="{StaticResource MonoFont}" TextChanged="TextChanged" />
                <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PortBox" Header="Port(s)" PlaceholderText="443, 500-501" FontFamily="{StaticResource MonoFont}" TextChanged="TextChanged" />
                    <ComboBox x:Name="ProtoBox" Grid.Column="1" Header="Protocol" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Changed">
                        <ComboBoxItem Content="any" Tag="" />
                        <ComboBoxItem Content="tcp" Tag="tcp" />
                        <ComboBoxItem Content="udp" Tag="udp" />
                        <ComboBoxItem Content="icmp" Tag="icmp" />
                        <ComboBoxItem Content="arp" Tag="arp" />
                        <ComboBoxItem Content="icmp6" Tag="icmp6" />
                    </ComboBox>
                    <TextBox x:Name="CustomBox" Grid.Column="2" Header="Extra BPF (ANDed)" PlaceholderText="not port 22"
                             FontFamily="{StaticResource MonoFont}" TextChanged="TextChanged" />
                </Grid>
                <ComboBox x:Name="VerbosityBox" Grid.Row="1" Grid.Column="2" Header="FortiGate verbosity" HorizontalAlignment="Stretch"
                          SelectedIndex="3" SelectionChanged="Changed">
                    <ComboBoxItem Content="1 · headers" />
                    <ComboBoxItem Content="2 · + IP payload" />
                    <ComboBoxItem Content="3 · + ethernet" />
                    <ComboBoxItem Content="4 · headers + intf" />
                    <ComboBoxItem Content="5 · payload + intf" />
                    <ComboBoxItem Content="6 · full + intf" />
                </ComboBox>
                <CheckBox x:Name="SudoBox" Grid.Row="1" Grid.Column="3" Content="sudo" IsChecked="True" VerticalAlignment="Bottom" Click="Clicked"
                          ToolTipService.ToolTip="Run tcpdump with sudo, typing the session's saved password" />

                <Grid Grid.Row="2" Grid.ColumnSpan="4" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="PcapBox" Content="Save to .pcap" Click="Clicked" VerticalAlignment="Center" />
                    <TextBox x:Name="CommandPreview" Grid.Column="1" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             Foreground="{StaticResource OmlSkyBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Click="Start_Click" MinWidth="110" AutomationProperties.Name="Start capture">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7C8;" FontSize="12" />
                                <TextBlock Text="Start capture" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopButton" Click="Stop_Click" IsEnabled="False" AutomationProperties.Name="Stop">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE71A;" FontSize="12" />
                                <TextBlock Text="Stop" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="WiresharkButton" Click="Wireshark_Click" IsEnabled="False" ToolTipService.ToolTip="Open the saved capture in Wireshark" AutomationProperties.Name="Open the saved capture in Wireshark">
                            <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="LiveDot" Width="10" Height="10" Fill="{StaticResource StatusIdleBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="Idle" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <ToggleButton x:Name="AutoScroll" IsChecked="True" Content="Follow" Padding="10,3" />
                <Button Content="Clear" Click="Clear_Click" Padding="10,3" />
                <Button Content="Save text..." Click="SaveText_Click" Padding="10,3" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="Output" Grid.Row="3" Style="{StaticResource MonoOutputStyle}" />
    </Grid>
</UserControl>
