<UserControl
    x:Class="OmlTerminal.App.Views.Tools.CopilotView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OmlTerminal.Core.Models"
    xmlns:local="using:OmlTerminal.App.Views.Tools">

    <Grid Padding="24,20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="AI Copilot" Style="{StaticResource ToolTitleStyle}" />
            <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="13" TextWrapping="Wrap"
                       Text="Points at a local, OpenAI-compatible model (LM Studio, Ollama, etc.) with its own side-channel connection to one device - never the terminal tab you have open." />
        </StackPanel>

        <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Warning"
                 Title="This can run commands on the device by itself."
                 Message="Read-only commands (show/ping/display/...) run automatically. Anything else needs your approval below before it's sent - nothing is ever hidden from you." />

        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="DeviceBox" Header="Device" HorizontalAlignment="Stretch" PlaceholderText="Pick a saved SSH session"
                          DisplayMemberPath="Display" />
                <TextBox x:Name="BaseUrlBox" Grid.Column="1" Header="Model endpoint (OpenAI-compatible)" FontFamily="{StaticResource MonoFont}" FontSize="12"
                         PlaceholderText="http://localhost:1234/v1" TextChanged="Config_Changed" />
                <TextBox x:Name="ModelBox" Grid.Column="2" Header="Model" FontFamily="{StaticResource MonoFont}" FontSize="12" TextChanged="Config_Changed" />
                <ToggleSwitch x:Name="EnabledBox" Grid.Column="3" Header="Copilot" OnContent="On" OffContent="Off" VerticalAlignment="Bottom" Toggled="Enabled_Toggled" />
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="ApiKeyBox" Header="API key (only if your endpoint needs one)" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             PlaceholderText="leave blank if none" PasswordChanged="ApiKey_Changed" />
                <TextBlock Grid.Column="1" x:Name="ApiKeyHint" FontSize="11" Opacity="0.55" VerticalAlignment="Bottom" TextWrapping="Wrap" />
            </Grid>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource ToolCardStyle}" Padding="0">
            <ListView x:Name="Transcript" Padding="8" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:CopilotChatRow">
                        <Grid ColumnSpacing="10" Padding="8,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind Brush}" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Border x:Name="ConfirmBar" Grid.Row="4" Style="{StaticResource ToolCardStyle}" BorderBrush="{StaticResource OmlAmberBrush}" BorderThickness="1" Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                <Button Grid.Column="1" Content="Approve &amp; run" Style="{StaticResource AccentButtonStyle}" Click="Approve_Click" />
                <Button Grid.Column="2" Content="Decline" Click="Decline_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="5" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" PlaceholderText="Ask the copilot to check or fix something on the selected device..."
                     AcceptsReturn="False" KeyDown="InputBox_KeyDown" />
            <Button Grid.Column="1" x:Name="SendButton" Content="Send" Style="{StaticResource AccentButtonStyle}" Click="Send_Click" />
            <Button Grid.Column="2" x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False" />
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="StatusText" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
            <Button Content="Open audit log folder" Click="OpenLogs_Click" Padding="10,3" />
        </StackPanel>
    </Grid>
</UserControl>
