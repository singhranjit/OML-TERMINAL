<UserControl
    x:Class="OmlTerminal.App.Views.Tools.TrafficGraphView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmlTerminal.App.Views.Tools">

    <Grid Padding="24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Traffic Graphs (MRTG)" Style="{StaticResource ToolTitleStyle}" />
            <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="13" TextWrapping="Wrap"
                       Text="SNMP v1/v2c/v3 interface traffic, MRTG-style: live, daily, weekly, monthly and yearly graphs per interface with peak, average, current, 95th percentile and volume, errors and discards, and an alert when a link runs hot. Keeps polling in the background while the app is open; history is kept for two years." />
        </StackPanel>

        <InfoBar x:Name="AlertBar" Grid.Row="1" Severity="Warning" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ToolCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="14,12" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DEVICES" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Click="AddDevice_Click" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Add a device to graph" AutomationProperties.Name="Add device">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="12" /><TextBlock Text="Add" /></StackPanel>
                        </Button>
                        <Button Grid.Column="2" Click="EditDevice_Click" ToolTipService.ToolTip="Edit (credentials, interfaces, polling)" AutomationProperties.Name="Edit device"><FontIcon Glyph="&#xE70F;" FontSize="12" /></Button>
                        <Button Grid.Column="3" Click="RemoveDevice_Click" ToolTipService.ToolTip="Remove the device and its history" AutomationProperties.Name="Remove device"><FontIcon Glyph="&#xE74D;" FontSize="12" /></Button>
                    </Grid>
                    <ListView x:Name="DeviceList" Grid.Row="1" SelectionMode="Single" SelectionChanged="DeviceList_SelectionChanged" Padding="6,0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DeviceRow">
                                <Grid ColumnSpacing="8" Padding="2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="{x:Bind Brush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}" FontSize="11.5" Opacity="0.65" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Click="Back_Click" Visibility="Collapsed" AutomationProperties.Name="All interfaces">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72B;" FontSize="12" /><TextBlock Text="All interfaces" /></StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HeadTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="HeadDetail" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Click="PollNow_Click" ToolTipService.ToolTip="Poll now" AutomationProperties.Name="Poll now"><FontIcon Glyph="&#xE72C;" FontSize="12" /></Button>
                        <Button Click="ExportCsv_Click" ToolTipService.ToolTip="Export the shown interface's history (CSV)" AutomationProperties.Name="Export traffic CSV"><FontIcon Glyph="&#xE74E;" FontSize="12" /></Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <VariableSizedWrapGrid x:Name="Overview" Orientation="Horizontal" ItemWidth="372" ItemHeight="214" />
                        <StackPanel x:Name="DetailPanel" Spacing="12" Visibility="Collapsed" />
                        <TextBlock x:Name="EmptyText" Margin="8,20" Opacity="0.6" TextWrapping="Wrap"
                                   Text="Add a device: its address and SNMP community (or v3 user), then pick the interfaces to graph. The first points appear after two polls." />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
