<UserControl
    x:Class="OmlTerminal.App.Views.Tools.HostMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OmlTerminal.Core.Models"
    xmlns:local="using:OmlTerminal.App.Views.Tools">

    <Grid Padding="24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Host Monitor" Style="{StaticResource ToolTitleStyle}" />
            <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="13" TextWrapping="Wrap"
                       Text="Live load average, memory, disk and uptime for saved SSH sessions - Linux/Unix hosts only. Polls over its own side-channel connection, so it never types into a terminal tab you're using." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Devices -->
            <Border Style="{StaticResource ToolCardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="DEVICES" Style="{StaticResource SectionLabelStyle}" />
                    <AutoSuggestBox x:Name="DeviceFilter" Grid.Row="1" PlaceholderText="Filter by name, folder, host" QueryIcon="Filter"
                                    TextChanged="DeviceFilter_TextChanged" />
                    <ListView x:Name="DeviceList" Grid.Row="2" SelectionMode="Multiple" SelectionChanged="DeviceList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SessionProfile">
                                <StackPanel Padding="0,4">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Host}" FontSize="11" Opacity="0.55" FontFamily="{StaticResource MonoFont}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="3" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SelectedText" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                        <Button Grid.Column="1" Content="All" Click="SelectAll_Click" Padding="10,3" />
                        <Button Grid.Column="2" Content="None" Click="SelectNone_Click" Padding="10,3" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Controls -->
                <Border Style="{StaticResource ToolCardStyle}" Padding="14,10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="IntervalBox" Header="Poll every (s)" Value="5" Minimum="2" Maximum="300" Width="120" SpinButtonPlacementMode="Hidden" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                            <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Click="Start_Click" MinWidth="130" AutomationProperties.Name="Start monitoring">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                                    <TextBlock Text="Start monitoring" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Click="Stop_Click" IsEnabled="False" AutomationProperties.Name="Stop">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71A;" FontSize="12" />
                                    <TextBlock Text="Stop" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Live table -->
                <Border Grid.Row="1" Style="{StaticResource ToolCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="16,10" ColumnSpacing="12" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="DEVICE" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Grid.Column="2" Text="LOAD (1m / 5m / 15m)" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Grid.Column="3" Text="MEMORY" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Grid.Column="4" Text="DISK /" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Grid.Column="5" Text="UPTIME / STATUS" Style="{StaticResource SectionLabelStyle}" />
                        </Grid>
                        <ListView x:Name="MonitorList" Grid.Row="1" SelectionMode="None" Padding="4">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:MonitorRow">
                                    <Grid ColumnSpacing="12" Padding="8,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" Fill="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Host}" FontSize="11" Opacity="0.55" FontFamily="{StaticResource MonoFont}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind LoadText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind MemText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind DiskText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind UptimeText, Mode=OneWay}" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{x:Bind StatusBrush, Mode=OneWay}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
