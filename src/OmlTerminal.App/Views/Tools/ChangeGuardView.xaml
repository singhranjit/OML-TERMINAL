<UserControl
    x:Class="OmlTerminal.App.Views.Tools.ChangeGuardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OmlTerminal.Core.Models"
    xmlns:local="using:OmlTerminal.App.Views.Tools">

    <Grid Padding="24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Change Guard" Style="{StaticResource ToolTitleStyle}" />
            <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="13" TextWrapping="Wrap"
                       Text="Snapshot interfaces, routes, BGP/OSPF neighbors, error counters and more before a change - then again after - and get a plain-English list of what went down, rerouted or disappeared. Only read-only show/get commands are sent, on their own connection." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Change setup -->
            <Border Style="{StaticResource ToolCardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="CHANGE" Style="{StaticResource SectionLabelStyle}" />
                    <TextBox x:Name="ChangeNameBox" Grid.Row="1" Header="Change name or ticket" PlaceholderText="e.g. CHG0012345 core uplink swap" />
                    <ComboBox x:Name="SavedBox" Grid.Row="2" Header="Or reopen a saved change" HorizontalAlignment="Stretch" PlaceholderText="Saved changes" SelectionChanged="SavedBox_SelectionChanged" />
                    <ComboBox x:Name="ProfileBox" Grid.Row="3" Header="Checks for" HorizontalAlignment="Stretch" SelectionChanged="ProfileBox_SelectionChanged" />
                    <Grid x:Name="CustomPanel" Grid.Row="4" RowSpacing="6" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="CustomCommands" Header="Commands (one per line, compared line by line)" Style="{StaticResource MonoInputStyle}" Height="90"
                                 Text="show ip route summary&#x0a;show interfaces status" />
                        <ComboBox x:Name="CustomMode" Grid.Row="1" HorizontalAlignment="Stretch" SelectedIndex="1">
                            <ComboBoxItem Content="Exec channel (NX-OS, Junos, FortiOS, Linux)" />
                            <ComboBoxItem Content="Interactive shell (IOS, ASA, PAN-OS)" />
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="ProfileHint" Grid.Row="5" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                    <Grid Grid.Row="6" ColumnSpacing="8" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DEVICES" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <AutoSuggestBox x:Name="DeviceFilter" Grid.Column="1" PlaceholderText="Filter" QueryIcon="Filter" TextChanged="DeviceFilter_TextChanged" />
                    </Grid>
                    <ListView x:Name="DeviceList" Grid.Row="7" SelectionMode="Multiple" SelectionChanged="DeviceList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SessionProfile">
                                <StackPanel Padding="0,4">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Host}" FontSize="11" Opacity="0.55" FontFamily="{StaticResource MonoFont}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="8" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SelectedText" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                        <Button Grid.Column="1" Content="All" Click="SelectAll_Click" Padding="10,3" />
                        <Button Grid.Column="2" Content="None" Click="SelectNone_Click" Padding="10,3" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1.4*" />
                </Grid.RowDefinitions>

                <!-- Actions -->
                <Border Style="{StaticResource ToolCardStyle}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PreButton" Style="{StaticResource AccentButtonStyle}" Click="Pre_Click" MinWidth="170">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="1" FontWeight="Bold" />
                                <TextBlock Text="Take PRE snapshot" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PostButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="Post_Click" MinWidth="200">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="2" FontWeight="Bold" />
                                <TextBlock Text="Take POST &amp; compare" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelButton" Grid.Column="2" Click="Cancel_Click" IsEnabled="False" ToolTipService.ToolTip="Stop" AutomationProperties.Name="Stop">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                        <TextBlock x:Name="StatusText" Grid.Column="3" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5" Opacity="0.85"
                                   Text="Name the change, pick devices, take PRE. Make your change. Then take POST." />
                    </Grid>
                </Border>

                <!-- Per device -->
                <Border Grid.Row="1" Style="{StaticResource ToolCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="16,10" ColumnSpacing="12" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.6*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DEVICE" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="PRE" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Grid.Column="2" Text="POST" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Grid.Column="3" Text="VERDICT" Style="{StaticResource SectionLabelStyle}" />
                        </Grid>
                        <ListView x:Name="RowList" Grid.Row="1" SelectionMode="Single" SelectionChanged="RowList_SelectionChanged" Padding="4">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:GuardRow">
                                    <Grid ColumnSpacing="12" Padding="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.6*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Host}" FontSize="11" Opacity="0.55" FontFamily="{StaticResource MonoFont}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind PreText, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind PostText, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind VerdictGlyph, Mode=OneWay}" Foreground="{x:Bind VerdictBrush, Mode=OneWay}" FontSize="14" />
                                            <TextBlock Text="{x:Bind Verdict, Mode=OneWay}" Foreground="{x:Bind VerdictBrush, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Findings -->
                <Border Grid.Row="2" Style="{StaticResource ToolCardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FindingsTitle" Text="WHAT CHANGED" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Click="CopyReport_Click" ToolTipService.ToolTip="Copy the report for every device (paste into the change ticket)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                        <TextBlock Text="Copy report" />
                                    </StackPanel>
                                </Button>
                                <Button Click="SaveReport_Click" ToolTipService.ToolTip="Save the report as .txt" AutomationProperties.Name="Save report">
                                    <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                </Button>
                                <Button Click="OpenFolder_Click" ToolTipService.ToolTip="Open the raw captures in Explorer" AutomationProperties.Name="Open captures folder">
                                    <FontIcon Glyph="&#xE838;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ListView x:Name="FindingList" Grid.Row="1" SelectionMode="None" Padding="0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:FindingRow">
                                    <Grid ColumnSpacing="10" Padding="2,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind Brush}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Finding.Check}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="2" Spacing="3">
                                            <TextBlock Text="{x:Bind Finding.Message}" Foreground="{x:Bind Brush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind DetailText}" Visibility="{x:Bind DetailVisibility}" FontFamily="{StaticResource MonoFont}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
