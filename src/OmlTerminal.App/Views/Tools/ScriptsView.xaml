<UserControl
    x:Class="OmlTerminal.App.Views.Tools.ScriptsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OmlTerminal.Core.Models"
    xmlns:scripting="using:OmlTerminal.Core.Scripting">

    <Grid Padding="24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Scripts" Style="{StaticResource ToolTitleStyle}" />
            <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="13" TextWrapping="Wrap"
                       Text="Drop a .ps1 / .py / .sh / .cmd file into the scripts folder and it shows up here. Each run is a separate process - the same trust level as running it yourself - and gets the picked session's name/host/username/protocol/folder as OML_SESSION_* environment variables." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Script list -->
            <Border Style="{StaticResource ToolCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="14,10" ColumnSpacing="8" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SCRIPTS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Click="OpenFolder_Click" ToolTipService.ToolTip="Open scripts folder" AutomationProperties.Name="Open scripts folder" Padding="8,4">
                            <FontIcon Glyph="&#xE8DA;" FontSize="12" />
                        </Button>
                        <Button Grid.Column="2" Click="Refresh_Click" ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh" Padding="8,4">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        </Button>
                    </Grid>
                    <ListView x:Name="ScriptList" Grid.Row="1" SelectionMode="Single" Padding="4">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="scripting:ScriptDefinition">
                                <StackPanel Padding="6,5">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Description}" FontSize="11.5" Opacity="0.6" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource ToolCardStyle}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SessionBox" Header="Session context (optional)" HorizontalAlignment="Stretch"
                                  PlaceholderText="(none)" DisplayMemberPath="Display" />
                        <Button Grid.Column="1" x:Name="RunButton" Content="Run" Style="{StaticResource AccentButtonStyle}" Click="Run_Click" VerticalAlignment="Bottom" MinWidth="90" />
                        <Button Grid.Column="2" x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>

                <TextBox x:Name="StdinBox" Grid.Row="1" Header="Stdin (optional) - paste anything the script should read"
                         Style="{StaticResource MonoInputStyle}" AcceptsReturn="True" Height="70" />

                <Border Grid.Row="2" Style="{StaticResource ToolCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="14,8" ColumnSpacing="10" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OUTPUT" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBox x:Name="OutputBox" Grid.Row="1" Style="{StaticResource MonoOutputStyle}" BorderThickness="0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
