<UserControl
    x:Class="OmlTerminal.App.Views.Tools.NetworkServicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Network Services" Style="{StaticResource ToolTitleStyle}" />
            <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="13"
                       Text="tftpd64 in your terminal: TFTP &amp; FTP servers for firmware/config transfer, plus a TFTP client, Syslog, SNTP and a lab DHCP server. Point a device at your PC's IP shown below." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ToolCardStyle}" Padding="14,8">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <SelectorBar x:Name="ServiceBar" SelectionChanged="Service_SelectionChanged">
                    <SelectorBarItem Text="TFTP server" IsSelected="True" />
                    <SelectorBarItem Text="TFTP client" />
                    <SelectorBarItem Text="FTP server" />
                    <SelectorBarItem Text="Syslog" />
                    <SelectorBarItem Text="SNTP" />
                    <SelectorBarItem Text="DHCP" />
                </SelectorBar>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="This PC:" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="PrimaryIpText" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                               Foreground="{StaticResource OmlMintBrush}" VerticalAlignment="Center" />
                    <Button Click="CopyIp_Click" ToolTipService.ToolTip="Copy IP" AutomationProperties.Name="Copy IP" Padding="8,4">
                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Config panels -->
            <Border Style="{StaticResource ToolCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- TFTP server -->
                        <StackPanel x:Name="TftpPanel" Spacing="10">
                            <TextBlock Text="TFTP SERVER" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Text="Serve and receive files for firmware/config transfer (e.g. 'copy tftp' on a switch)." Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                            <TextBox x:Name="TftpRoot" Header="Root folder" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                            <Button Content="Browse..." Click="BrowseTftpRoot_Click" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="TftpBind" Header="Bind address" HorizontalAlignment="Stretch" />
                                <NumberBox x:Name="TftpPort" Grid.Column="1" Header="Port" Value="69" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden" />
                            </Grid>
                            <CheckBox x:Name="TftpAllowWrite" Content="Allow uploads (WRQ)" IsChecked="True" />
                            <CheckBox x:Name="TftpOverwrite" Content="Allow overwriting existing files" />
                            <Button x:Name="TftpToggle" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="TftpToggle_Click" Content="Start TFTP server" />
                        </StackPanel>

                        <!-- TFTP client -->
                        <StackPanel x:Name="TftpClientPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="TFTP CLIENT" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Text="Get or put a file to a remote TFTP server (e.g. a switch)." Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ClientHost" Header="Server host" FontFamily="{StaticResource MonoFont}" PlaceholderText="10.0.0.1" />
                                <NumberBox x:Name="ClientPort" Grid.Column="1" Header="Port" Value="69" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden" />
                            </Grid>
                            <TextBox x:Name="ClientRemote" Header="Remote filename" FontFamily="{StaticResource MonoFont}" PlaceholderText="running-config" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ClientLocal" Header="Local file" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                <Button Grid.Column="1" Content="..." VerticalAlignment="Bottom" Click="BrowseClientLocal_Click" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ClientGet" Style="{StaticResource AccentButtonStyle}" Content="Download (GET)" Click="ClientGet_Click" />
                                <Button x:Name="ClientPut" Content="Upload (PUT)" Click="ClientPut_Click" />
                            </StackPanel>
                            <ProgressBar x:Name="ClientProgress" Maximum="1" Visibility="Collapsed" />
                            <TextBlock x:Name="ClientStatus" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- FTP server -->
                        <StackPanel x:Name="FtpPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="FTP SERVER" Style="{StaticResource SectionLabelStyle}" />
                            <TextBox x:Name="FtpRoot" Header="Root folder" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                            <Button Content="Browse..." Click="BrowseFtpRoot_Click" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="FtpBind" Header="Bind address" HorizontalAlignment="Stretch" />
                                <NumberBox x:Name="FtpPort" Grid.Column="1" Header="Port" Value="21" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden" />
                            </Grid>
                            <CheckBox x:Name="FtpAnon" Content="Allow anonymous login" IsChecked="True" Click="FtpAnon_Click" />
                            <Grid x:Name="FtpCreds" ColumnSpacing="10" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FtpUser" Header="Username" />
                                <TextBox x:Name="FtpPass" Header="Password" Grid.Column="1" />
                            </Grid>
                            <CheckBox x:Name="FtpReadOnly" Content="Read-only (no uploads/deletes)" />
                            <Button x:Name="FtpToggle" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="FtpToggle_Click" Content="Start FTP server" />
                        </StackPanel>

                        <!-- Syslog -->
                        <StackPanel x:Name="SyslogPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="SYSLOG SERVER" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Text="Receive log messages from devices. Point 'logging host' at this PC." Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SyslogBind" Header="Bind address" HorizontalAlignment="Stretch" />
                                <NumberBox x:Name="SyslogPort" Grid.Column="1" Header="Port" Value="514" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden" />
                            </Grid>
                            <CheckBox x:Name="SyslogToFile" Content="Also save to a log file" Click="SyslogToFile_Click" />
                            <Grid x:Name="SyslogFileRow" ColumnSpacing="6" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SyslogFile" Header="Log file" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                <Button Grid.Column="1" Content="..." VerticalAlignment="Bottom" Click="BrowseSyslogFile_Click" />
                            </Grid>
                            <Button x:Name="SyslogToggle" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="SyslogToggle_Click" Content="Start Syslog server" />
                        </StackPanel>

                        <!-- SNTP -->
                        <StackPanel x:Name="SntpPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="SNTP / NTP TIME SERVER" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Text="Answer time queries from this PC's clock, for isolated labs with no internet." Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                            <ComboBox x:Name="SntpBind" Header="Bind address" HorizontalAlignment="Stretch" />
                            <Button x:Name="SntpToggle" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="SntpToggle_Click" Content="Start SNTP server" />
                        </StackPanel>

                        <!-- DHCP -->
                        <StackPanel x:Name="DhcpPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="DHCP SERVER (LAB)" Style="{StaticResource SectionLabelStyle}" />
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Message="Only run on an isolated lab network. Two DHCP servers on one LAN break connectivity for everyone." />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DhcpStart" Header="Pool start" FontFamily="{StaticResource MonoFont}" Text="10.10.10.100" />
                                <TextBox x:Name="DhcpEnd" Grid.Column="1" Header="Pool end" FontFamily="{StaticResource MonoFont}" Text="10.10.10.150" />
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DhcpMask" Header="Subnet mask" FontFamily="{StaticResource MonoFont}" Text="255.255.255.0" />
                                <TextBox x:Name="DhcpGateway" Grid.Column="1" Header="Gateway" FontFamily="{StaticResource MonoFont}" Text="10.10.10.1" />
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DhcpDns" Header="DNS server" FontFamily="{StaticResource MonoFont}" Text="10.10.10.1" />
                                <ComboBox x:Name="DhcpBind" Grid.Column="1" Header="Bind / server IP" HorizontalAlignment="Stretch" />
                            </Grid>
                            <Button x:Name="DhcpToggle" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="DhcpToggle_Click" Content="Start DHCP server" />
                            <TextBlock x:Name="DhcpLeases" FontFamily="{StaticResource MonoFont}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Shared log -->
            <Border Grid.Column="1" Style="{StaticResource ToolCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="14,10" ColumnSpacing="10" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ACTIVITY LOG" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <TextBlock x:Name="RunningText" Grid.Column="1" FontSize="12" Opacity="0.7" VerticalAlignment="Center" Margin="10,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <ToggleButton x:Name="Follow" Content="Follow" IsChecked="True" Padding="10,3" />
                            <Button Content="Clear" Click="ClearLog_Click" Padding="10,3" />
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource MonoOutputStyle}" BorderThickness="0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
