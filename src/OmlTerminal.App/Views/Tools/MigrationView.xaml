<UserControl
    x:Class="OmlTerminal.App.Views.Tools.MigrationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OmlTerminal.Core.Models"
    xmlns:local="using:OmlTerminal.App.Views.Tools">

    <Grid Padding="24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Config Migration" Style="{StaticResource ToolTitleStyle}" />
            <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="13" TextWrapping="Wrap"
                       Text="Move address objects, service objects and ACL/policy rules between Cisco ASA/FTD, FortiGate, Palo Alto, Juniper SRX and pfSense, in any direction. Check Point and Sophos aren't supported yet - neither exports a flat config file this tool can parse reliably. NAT, VPN, routing and HA are not translated - they're listed below for manual recreation instead of being guessed at." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- Source -->
            <Border Style="{StaticResource ToolCardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ComboBox x:Name="SourceVendorBox" Header="Source vendor" HorizontalAlignment="Stretch" SelectedIndex="0" />

                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="DeviceBox" Header="Or pull from a saved SSH session" HorizontalAlignment="Stretch"
                                  PlaceholderText="Pick a device" DisplayMemberPath="Display" />
                        <Button Grid.Column="1" Content="Pull" Click="Pull_Click" VerticalAlignment="Bottom" />
                    </Grid>

                    <TextBox x:Name="InputBox" Grid.Row="2" Style="{StaticResource MonoInputStyle}" AcceptsReturn="True"
                             PlaceholderText="Paste 'show running-config' here, or load a file, or pull from a device above" />

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                        <Button Content="Load file..." Click="LoadFile_Click" />
                        <Button x:Name="ParseButton" Content="Parse" Style="{StaticResource AccentButtonStyle}" Click="Parse_Click" />
                    </StackPanel>

                    <TextBlock x:Name="SummaryText" Grid.Row="4" FontSize="12.5" Opacity="0.75" TextWrapping="Wrap" />
                    <InfoBar x:Name="IssuesBar" Grid.Row="5" Severity="Warning" IsClosable="False" IsOpen="False" Title="Lines skipped (couldn't be parsed with confidence)" Message="" />
                </Grid>
            </Border>

            <!-- Interface mapping + target -->
            <Border Grid.Column="1" Style="{StaticResource ToolCardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="TargetVendorBox" Header="Migrate to" HorizontalAlignment="Stretch" SelectionChanged="TargetVendor_SelectionChanged" />
                    <TextBlock Grid.Row="1" Text="INTERFACE / ZONE MAPPING" Style="{StaticResource SectionLabelStyle}" />
                    <ListView x:Name="InterfaceList" Grid.Row="2" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:InterfaceMapRow">
                                <Grid ColumnSpacing="8" Padding="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Original}" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                                    <TextBlock Grid.Column="1" Text="→" Opacity="0.5" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{x:Bind MappedName, Mode=TwoWay}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" PlaceholderText="{x:Bind Original}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Grid.Row="3" Content="Generate" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="Generate_Click" IsEnabled="False" x:Name="GenerateButton" />
                </Grid>
            </Border>

            <!-- Output -->
            <Border Grid.Column="2" Style="{StaticResource ToolCardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OUTPUT" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Click="Copy_Click" ToolTipService.ToolTip="Copy to clipboard" AutomationProperties.Name="Copy">
                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                            </Button>
                            <Button Click="Save_Click" ToolTipService.ToolTip="Save as a .txt script" AutomationProperties.Name="Save as a .txt script">
                                <FontIcon Glyph="&#xE74E;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <InfoBar x:Name="ReviewBar" Grid.Row="1" Severity="Informational" IsClosable="False" IsOpen="False" Title="Needs manual review - not migrated" Message="" />
                    <TextBox x:Name="OutputBox" Grid.Row="2" Style="{StaticResource MonoOutputStyle}"
                             PlaceholderText="Paste or pull a source config, click Parse, then Generate." />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
