<UserControl
    x:Class="OmlTerminal.App.Views.Tools.PasswordManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmlTerminal.App.Views.Tools"
    xmlns:models="using:OmlTerminal.Core.Models">

    <Grid Padding="24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Password Manager" Style="{StaticResource ToolTitleStyle}" />
            <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="13" TextWrapping="Wrap"
                       Text="Save each login once - username, password and enable password - and link it to as many sessions as you like. Connections, Telnet logins, auto-enable and Config Backup all use it; change a password here and every linked device picks it up." />
        </StackPanel>

        <InfoBar x:Name="SecurityBar" Grid.Row="1" IsOpen="True" IsClosable="False" />

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Credential list -->
            <Border Style="{StaticResource ToolCardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="New_Click" AutomationProperties.Name="New credential">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="New credential" />
                        </StackPanel>
                    </Button>
                    <AutoSuggestBox x:Name="FilterBox" Grid.Row="1" PlaceholderText="Search credentials" QueryIcon="Find" TextChanged="FilterBox_TextChanged" />
                    <ListView x:Name="CredList" Grid.Row="2" SelectionMode="Single" SelectionChanged="CredList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:CredentialRow">
                                <Grid ColumnSpacing="10" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource BadgeBackgroundBrush}"
                                            BorderBrush="{StaticResource BadgeBorderBrush}" BorderThickness="1">
                                        <FontIcon Glyph="&#xE8D7;" FontSize="14" Foreground="{StaticResource OmlSkyBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}" FontSize="11" Opacity="0.6" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Editor -->
            <Border Grid.Column="1" Style="{StaticResource ToolCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Editor" Spacing="12" Padding="0,0,8,0">
                        <TextBlock x:Name="EditorTitle" Text="NEW CREDENTIAL" Style="{StaticResource SectionLabelStyle}" />
                        <TextBox x:Name="NameBox" Header="Name *" PlaceholderText="e.g. TACACS netops, Branch firewalls, lab-admin" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UserBox" Header="Username" FontFamily="{StaticResource MonoFont}" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="CopyUser_Click" ToolTipService.ToolTip="Copy username" AutomationProperties.Name="Copy username">
                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                            </Button>
                        </Grid>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PasswordBox" Header="Password" PasswordRevealMode="Peek" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="CopyPassword_Click" ToolTipService.ToolTip="Copy password (clipboard clears in 30 s)" AutomationProperties.Name="Copy password">
                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                            </Button>
                        </Grid>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="EnableBox" Header="Enable password (Cisco privileged mode - optional)" PasswordRevealMode="Peek" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="CopyEnable_Click" ToolTipService.ToolTip="Copy enable password (clipboard clears in 30 s)" AutomationProperties.Name="Copy enable password">
                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                            </Button>
                        </Grid>
                        <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="80" PlaceholderText="Rotation date, owner, ticket..." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="Save_Click" MinWidth="100" AutomationProperties.Name="Save credential">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                    <TextBlock Text="Save" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeleteButton" Click="Delete_Click" IsEnabled="False" AutomationProperties.Name="Delete credential">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    <TextBlock Text="Delete" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Linked sessions -->
            <Border Grid.Column="2" Style="{StaticResource ToolCardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LinkTitle" Text="USED BY SESSIONS" Style="{StaticResource SectionLabelStyle}" />
                    <AutoSuggestBox x:Name="SessionFilter" Grid.Row="1" PlaceholderText="Filter sessions by name, folder, host" QueryIcon="Filter"
                                    TextChanged="SessionFilter_TextChanged" />
                    <ListView x:Name="SessionList" Grid.Row="2" SelectionMode="Multiple" SelectionChanged="SessionList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:LinkRow">
                                <Grid ColumnSpacing="10" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="50" Height="22" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Profile.ProtocolLabel}" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Profile.Display}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}" FontSize="11" Opacity="0.55" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="3" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LinkCount" VerticalAlignment="Center" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <Button x:Name="ApplyLinksButton" Grid.Column="1" Style="{StaticResource OmlAccentButtonStyle}" Padding="14,6" Click="ApplyLinks_Click"
                                IsEnabled="False" Content="Apply links" AutomationProperties.Name="Apply links" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
