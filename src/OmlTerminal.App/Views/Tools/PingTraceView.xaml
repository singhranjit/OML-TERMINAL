<UserControl
    x:Class="OmlTerminal.App.Views.Tools.PingTraceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Ping · Trace · Sweep" Style="{StaticResource ToolTitleStyle}" />
            <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="13"
                       Text="Continuous ping with loss/jitter stats, traceroute with reverse DNS, and ping sweep to find live hosts in a subnet (up to /20)." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ToolCardStyle}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ModeBox" Header="Mode" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Mode_SelectionChanged">
                    <ComboBoxItem Content="Ping" />
                    <ComboBoxItem Content="Traceroute" />
                    <ComboBoxItem Content="Ping sweep" />
                </ComboBox>
                <TextBox x:Name="TargetBox" Grid.Column="1" Header="Target" PlaceholderText="8.8.8.8 / host.example.com / 10.0.0.0/24"
                         FontFamily="{StaticResource MonoFont}" KeyDown="TargetBox_KeyDown" />
                <NumberBox x:Name="CountBox" Grid.Column="2" Header="Count (0 = ∞)" Value="0" Minimum="0" Maximum="100000" SpinButtonPlacementMode="Hidden" />
                <NumberBox x:Name="SizeBox" Grid.Column="3" Header="Size (bytes)" Value="32" Minimum="0" Maximum="65500" SpinButtonPlacementMode="Hidden" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Click="Start_Click" MinWidth="96" AutomationProperties.Name="Start">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                            <TextBlock Text="Start" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Click="Stop_Click" IsEnabled="False" ToolTipService.ToolTip="Stop" AutomationProperties.Name="Stop">
                        <FontIcon Glyph="&#xE71A;" FontSize="12" />
                    </Button>
                    <Button Click="Clear_Click" ToolTipService.ToolTip="Clear output" AutomationProperties.Name="Clear output">
                        <FontIcon Glyph="&#xE894;" FontSize="12" />
                    </Button>
                    <Button Click="Copy_Click" ToolTipService.ToolTip="Copy output" AutomationProperties.Name="Copy output">
                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource ToolCardStyle}" Padding="14,10">
                <StackPanel>
                    <TextBlock x:Name="Stat1Label" Text="SENT / RECEIVED" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock x:Name="Stat1" Text="-" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource ToolCardStyle}" Padding="14,10">
                <StackPanel>
                    <TextBlock x:Name="Stat2Label" Text="LOSS" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock x:Name="Stat2" Text="-" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource ToolCardStyle}" Padding="14,10">
                <StackPanel>
                    <TextBlock x:Name="Stat3Label" Text="MIN / AVG / MAX" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock x:Name="Stat3" Text="-" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource ToolCardStyle}" Padding="14,10">
                <StackPanel>
                    <TextBlock x:Name="Stat4Label" Text="JITTER" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock x:Name="Stat4" Text="-" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBox x:Name="Output" Grid.Row="3" Style="{StaticResource MonoOutputStyle}" />
    </Grid>
</UserControl>
