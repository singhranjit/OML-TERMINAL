<ContentDialog
    x:Class="OmlTerminal.App.Views.NewSessionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource AppContentDialogStyle}"
    Title="Session settings"
    PrimaryButtonText="Save &amp; Connect"
    SecondaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="660" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Width="780">
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False" Title="Cannot save" />

            <!-- Session type tiles (MobaXterm-style), built in code so each carries its protocol. -->
            <Border CornerRadius="{StaticResource CardRadius}" Padding="8" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                <StackPanel x:Name="TypeTiles" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" />
            </Border>

            <!-- Basic settings -->
            <Border CornerRadius="{StaticResource CardRadius}" Padding="16" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource GlowBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="BasicHeader" Text="BASIC SSH SETTINGS" Style="{StaticResource SectionLabelStyle}" />

                    <Grid x:Name="NetworkFieldsPanel" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HostBox" Header="Remote host *" PlaceholderText="10.0.0.1 or fw01.corp.local"
                                 FontFamily="{StaticResource MonoFont}" TextChanged="HostBox_TextChanged" />
                        <TextBox x:Name="UserBox" Grid.Column="1" Header="Username" PlaceholderText="admin" />
                        <NumberBox x:Name="PortBox" Grid.Column="2" Header="Port" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Inline" />
                    </Grid>

                    <Grid x:Name="SerialFieldsPanel" ColumnSpacing="10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SerialPortBox" Header="Serial port *" HorizontalAlignment="Stretch" IsEditable="True" />
                        <ComboBox x:Name="BaudBox" Grid.Column="1" Header="Speed (bps)" HorizontalAlignment="Stretch" IsEditable="True" />
                    </Grid>

                    <StackPanel x:Name="LocalFieldsPanel" Spacing="10" Visibility="Collapsed">
                        <ComboBox x:Name="ShellPicker" Header="Shell" HorizontalAlignment="Stretch" SelectionChanged="ShellPicker_SelectionChanged" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ShellPathBox" Header="Executable (blank = PowerShell, then cmd.exe)" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     PlaceholderText="C:\cygwin64\bin\bash.exe" />
                            <TextBox x:Name="ShellArgsBox" Grid.Column="1" Header="Arguments" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     PlaceholderText="--login -i" />
                            <Button Grid.Column="2" VerticalAlignment="Bottom" Content="Browse..." Click="BrowseShell_Click" />
                        </Grid>
                        <TextBlock x:Name="ShellHint" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Advanced / Network / Bookmark -->
            <Border CornerRadius="{StaticResource CardRadius}" Padding="16,8,16,16" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <SelectorBar x:Name="SectionBar" SelectionChanged="SectionBar_SelectionChanged">
                        <SelectorBarItem x:Name="AdvancedTab" Text="Advanced" IsSelected="True">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE713;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="NetworkTab" Text="Network">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE968;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="BookmarkTab" Text="Bookmark">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE734;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>

                    <!-- Advanced -->
                    <StackPanel x:Name="AdvancedPanel" Spacing="12">
                        <Grid x:Name="SshAdvanced" ColumnSpacing="10" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ComboBox x:Name="EngineBox" Header="SSH engine" HorizontalAlignment="Stretch" SelectionChanged="EngineBox_SelectionChanged">
                                <ComboBoxItem Content="Built-in (SSH.NET) - tunnels, jump host" Tag="BuiltIn" />
                                <ComboBoxItem Content="OpenSSH (ssh.exe) - X11, ~/.ssh/config" Tag="OpenSsh" />
                                <ComboBoxItem Content="PuTTY (plink.exe) - legacy ciphers" Tag="Plink" />
                            </ComboBox>
                            <ComboBox x:Name="AuthMethodBox" Grid.Column="1" Header="Authentication" HorizontalAlignment="Stretch"
                                      SelectionChanged="AuthMethodBox_SelectionChanged">
                                <ComboBoxItem Content="Password" Tag="Password" />
                                <ComboBoxItem Content="Private key" Tag="PrivateKey" />
                            </ComboBox>
                            <CheckBox x:Name="X11Box" Grid.Row="1" Content="X11-forwarding (starts the local X server)" Click="X11Box_Click"
                                      ToolTipService.ToolTip="Show remote GUI apps (Wireshark, xterm, virt-manager) on this PC. Uses the OpenSSH engine." />
                            <TextBlock x:Name="EngineHint" Grid.Row="1" Grid.Column="1" FontSize="12" Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <StackPanel x:Name="KeyFieldsPanel" Grid.Row="2" Grid.ColumnSpan="2" Spacing="10" Visibility="Collapsed">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="KeyPathBox" Header="Private key file" PlaceholderText="C:\Users\you\.ssh\id_ed25519" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse..." Click="BrowseKey_Click" />
                                </Grid>
                                <PasswordBox x:Name="KeyPassphraseBox" Header="Key passphrase (leave blank if the key isn't encrypted)" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="CredentialRow" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CredentialBox" Header="Login from Password Manager" HorizontalAlignment="Stretch"
                                      SelectionChanged="CredentialBox_SelectionChanged" />
                            <PasswordBox x:Name="EnablePasswordBox" Grid.Column="1" Header="Enable password (Cisco, optional)" PasswordRevealMode="Peek" />
                        </Grid>
                        <PasswordBox x:Name="PasswordBox" Header="Password (saved encrypted; leave blank to be prompted)" PasswordRevealMode="Peek" />
                        <TextBox x:Name="StartupBox" Header="Execute after login (one command per line)" Style="{StaticResource MonoInputStyle}" AcceptsReturn="True" Height="72"
                                 PlaceholderText="terminal length 0&#x0a;show version | include uptime" />
                    </StackPanel>

                    <!-- Network -->
                    <StackPanel x:Name="NetworkPanel" Spacing="10" Visibility="Collapsed">
                        <CheckBox x:Name="UseJumpBox" Content="Connect through an SSH jump host / bastion" Checked="UseJumpBox_Changed" Unchecked="UseJumpBox_Changed" />
                        <TextBlock x:Name="JumpHint" Text="Works for SSH (built-in engine), SFTP and Telnet targets. The jump host's credentials are separate from the ones above."
                                   Opacity="0.6" TextWrapping="Wrap" FontSize="12" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="JumpHostBox" Header="Jump host" PlaceholderText="bastion.example.net" FontFamily="{StaticResource MonoFont}" />
                            <TextBox x:Name="JumpUserBox" Grid.Column="1" Header="Username" />
                            <PasswordBox x:Name="JumpPasswordBox" Grid.Column="2" Header="Password" />
                            <NumberBox x:Name="JumpPortBox" Grid.Column="3" Header="Port" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden" Value="22" />
                        </Grid>
                    </StackPanel>

                    <!-- Bookmark -->
                    <StackPanel x:Name="BookmarkPanel" Spacing="10" Visibility="Collapsed">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NameBox" Header="Session name *" PlaceholderText="core-sw1" />
                            <AutoSuggestBox x:Name="FolderBox" Grid.Column="1" Header="Folder" PlaceholderText="Datacenter/Core (optional)"
                                            TextChanged="FolderBox_TextChanged" SuggestionChosen="FolderBox_SuggestionChosen" />
                            <ComboBox x:Name="ColorBox" Grid.Column="2" Header="Colour tag" HorizontalAlignment="Stretch" />
                        </Grid>
                        <TextBox x:Name="NotesBox" Header="Notes (rack, owner, change ticket...)" AcceptsReturn="True" TextWrapping="Wrap" Height="72" />
                        <TextBox x:Name="TagsBox" Header="Tags (comma separated)" PlaceholderText="production, core, ios-xe" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
