<ContentDialog
    x:Class="OmlTerminal.App.Views.TunnelsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:transports="using:OmlTerminal.Core.Transports"
    Style="{StaticResource AppContentDialogStyle}"
    Title="SSH Tunnels"
    CloseButtonText="Close"
    DefaultButton="Close">

    <StackPanel Spacing="12" MinWidth="480">
        <TextBlock Text="Port forwards riding on this session's SSH connection. The remote server must allow TCP forwarding (most Linux/Unix jump hosts do; most network device SSH servers do not)."
                   Opacity="0.65" TextWrapping="Wrap" FontSize="12" />

        <ListView x:Name="TunnelList" MaxHeight="220" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="transports:TunnelSpec">
                    <Grid ColumnSpacing="10" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Display}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Remove" Click="Remove_Click" Tag="{x:Bind Id}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyText" Text="No tunnels yet." Opacity="0.55" />

        <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />

        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <StackPanel Spacing="10">
                <TextBlock Text="ADD TUNNEL" FontSize="11" FontWeight="Bold" CharacterSpacing="150" Foreground="{StaticResource OmlOrangeBrush}" />
                <ComboBox x:Name="KindBox" Header="Type" HorizontalAlignment="Stretch" SelectionChanged="KindBox_SelectionChanged">
                    <ComboBoxItem Content="Local  (a port on this PC -&gt; a target reachable from the remote)" Tag="Local" />
                    <ComboBoxItem Content="Remote  (a port on the remote -&gt; a target reachable from this PC)" Tag="Remote" />
                    <ComboBoxItem Content="Dynamic  (SOCKS proxy on this PC)" Tag="Dynamic" />
                </ComboBox>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BoundHostBox" Header="Bind address" Text="127.0.0.1" />
                    <NumberBox x:Name="BoundPortBox" Grid.Column="1" Header="Bind port (0 = auto)" Minimum="0" Maximum="65535" SpinButtonPlacementMode="Hidden" Value="0" />
                </Grid>
                <Grid x:Name="TargetRow" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetHostBox" Header="Target host" PlaceholderText="10.0.0.5" />
                    <NumberBox x:Name="TargetPortBox" Grid.Column="1" Header="Target port" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden" />
                </Grid>
                <Button Content="Add tunnel" Style="{StaticResource AccentButtonStyle}" Click="Add_Click" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
