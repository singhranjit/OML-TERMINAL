<ContentDialog
    x:Class="OmlTerminal.App.Views.ImportPuttyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmlTerminal.App.Views"
    Style="{StaticResource AppContentDialogStyle}"
    Title="Import from PuTTY"
    PrimaryButtonText="Import Selected"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="440">
        <TextBlock Text="Select the sessions to import. Each is added under an &quot;Imported from PuTTY&quot; folder - nothing in your PuTTY configuration is changed." Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
        <TextBlock x:Name="EmptyText" Text="No PuTTY saved sessions were found in the registry." Opacity="0.6" Visibility="Collapsed" TextWrapping="Wrap" />
        <ListView x:Name="RowsList" MaxHeight="420" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PuttyImportRow">
                    <Grid ColumnSpacing="10" Padding="2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="46" Height="22" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Profile.ProtocolLabel}" Style="{StaticResource BadgeTextStyle}" />
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Bind Profile.Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
