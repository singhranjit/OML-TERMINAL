<UserControl
    x:Class="OmlTerminal.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OmlTerminal.Core.Models"
    xmlns:tools="using:OmlTerminal.App.Views.Tools">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <!-- Soft neon glow behind the hero - pure decoration, never hit-testable. -->
            <Ellipse Width="900" Height="420" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-220,0,0" IsHitTestVisible="False" Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#5538BDF8" Offset="0" />
                        <GradientStop Color="#22A78BFA" Offset="0.5" />
                        <GradientStop Color="#0004060B" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel MaxWidth="1040" Spacing="26" Padding="32,40,32,32" HorizontalAlignment="Stretch">

                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/Logo.png" Width="88" Height="88" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource HeroTitleStyle}" FontSize="52" Text="OML Terminal" />
                        <TextBlock Text="The network &amp; security engineer's cockpit: every protocol, split view, multi-exec, X11, and a built-in toolkit. Free, no telemetry, no lock-in."
                                   Opacity="0.7" FontSize="15" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- Quick connect -->
                <Border CornerRadius="{StaticResource CardRadius}" Padding="6" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource GlowBorderBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE756;" FontSize="16" Margin="12,0,4,0" Foreground="{StaticResource OmlSkyBrush}" />
                        <TextBox x:Name="QuickBox" Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="15" BorderThickness="0"
                                 Background="Transparent" PlaceholderText="Quick connect:  admin@10.0.0.1:22   ·   telnet sw1 23   ·   core-rtr1"
                                 KeyDown="QuickBox_KeyDown" />
                        <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="QuickConnect_Click" Padding="18,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Connect" />
                                <FontIcon Glyph="&#xE72A;" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- New session tiles -->
                <StackPanel Spacing="10">
                    <TextBlock Text="NEW SESSION" Style="{StaticResource SectionLabelStyle}" />
                    <ItemsControl x:Name="SessionTiles">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="120" ItemHeight="96" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Toolkit -->
                <StackPanel Spacing="10">
                    <TextBlock Text="NETWORK &amp; SECURITY TOOLKIT" Style="{StaticResource SectionLabelStyle}" />
                    <GridView x:Name="ToolGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="ToolGrid_ItemClick" Padding="0">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="tools:ToolDescriptor">
                                <Border Width="236" Height="104" CornerRadius="{StaticResource CardRadius}" Padding="14"
                                        Background="{StaticResource CardBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="10" VerticalAlignment="Top"
                                                Background="{StaticResource BadgeBackgroundBrush}" BorderBrush="{StaticResource BadgeBorderBrush}" BorderThickness="1">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{StaticResource OmlSkyBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" MaxLines="3" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock Text="RECENT" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock x:Name="NoRecentText" Text="Nothing yet. Pick a session type above or add one from the sidebar." Opacity="0.55" />
                        <ListView x:Name="RecentList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="RecentList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SessionProfile">
                                    <Grid Padding="2,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="56" Height="24" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ProtocolLabel}" Style="{StaticResource BadgeTextStyle}" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Name}" />
                                            <TextBlock Text="{x:Bind Host}" Opacity="0.55" FontSize="12" FontFamily="{StaticResource MonoFont}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <Border Grid.Column="1" CornerRadius="{StaticResource CardRadius}" Padding="18" VerticalAlignment="Top"
                            Background="{StaticResource CardBrush}" BorderBrush="{StaticResource OmlOrangeBorderSubtleBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{StaticResource OmlOrangeBrush}" />
                                <TextBlock Text="OML lab node" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="Got a link from OML Labs? Paste it and connect in one step."
                                       Opacity="0.65" TextWrapping="Wrap" FontSize="13" />
                            <Button Content="Connect OML Node" Click="OmlNode_Click" HorizontalAlignment="Stretch"
                                    Style="{StaticResource OmlAccentButtonStyle}" />
                            <TextBlock Text="Ctrl+K opens the command palette - every session, tool and action by name."
                                       Opacity="0.5" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
