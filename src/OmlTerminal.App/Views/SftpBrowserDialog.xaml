<ContentDialog
    x:Class="OmlTerminal.App.Views.SftpBrowserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmlTerminal.App.Views"
    Style="{StaticResource AppContentDialogStyle}"
    CloseButtonText="Close"
    DefaultButton="Close">

    <Grid MinWidth="640" MinHeight="440" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Up" Click="Up_Click" />
            <TextBox Grid.Column="1" x:Name="PathBox" KeyDown="PathBox_KeyDown" FontFamily="{StaticResource MonoFont}" />
            <Button Grid.Column="2" Content="Go" Click="Go_Click" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="New Folder" Click="NewFolder_Click" />
            <Button Content="Upload..." Click="Upload_Click" />
            <Button Content="Refresh" Click="Refresh_Click" />
            <Button Content="Recent" Click="Recent_Click" ToolTipService.ToolTip="Recently visited folders on this session" />
            <ProgressRing x:Name="Busy" IsActive="False" Width="18" Height="18" />
            <TextBlock Text="Tip: drag files from File Explorer here to upload." Opacity="0.55" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>

        <ListView Grid.Row="2" x:Name="FileList" AllowDrop="True" Drop="FileList_Drop" DragOver="FileList_DragOver"
                  DoubleTapped="FileList_DoubleTapped" RightTapped="FileList_RightTapped" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SftpEntryView">
                    <Grid ColumnSpacing="12" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" Visibility="{x:Bind DirIconVisibility}" Foreground="{StaticResource OmlSkyBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" FontSize="12" Opacity="0.65" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Modified}" FontSize="12" Opacity="0.55" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <InfoBar Grid.Row="3" x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />
    </Grid>
</ContentDialog>
