<ContentDialog
    x:Class="OmlTerminal.App.Views.WorkflowDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource AppContentDialogStyle}"
    Title="Troubleshooting workflows"
    PrimaryButtonText="Save"
    SecondaryButtonText="Save &amp; Run"
    CloseButtonText="Cancel"
    DefaultButton="Primary">
    <Grid MinWidth="760" MinHeight="450" ColumnSpacing="14" RowSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Grid.ColumnSpan="2" Text="Saved command sequences. Review every command before running it on the active session." TextWrapping="Wrap" Opacity="0.7" />
        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Button Content="New workflow" Click="New_Click" />
            <ListView x:Name="WorkflowList" Grid.Row="1" SelectionChanged="WorkflowList_SelectionChanged" />
        </Grid>
        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
            <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" />
            <TextBox x:Name="NameBox" Header="Name" />
            <TextBox x:Name="DescriptionBox" Header="Description" />
            <TextBox x:Name="CommandsBox" Header="Commands (one per line)" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="{StaticResource MonoFont}" Height="250" />
            <TextBlock Text="Commands are sent to the active connected terminal with a short delay. Keep commands read-only unless you intentionally need to change device state." TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
            <Button Content="Delete selected workflow" HorizontalAlignment="Left" Click="Delete_Click" />
        </StackPanel>
    </Grid>
</ContentDialog>
