<ContentDialog
    x:Class="OmlTerminal.App.Views.VoiceCommandDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource AppContentDialogStyle}"
    Title="Voice Command"
    PrimaryButtonText="Send"
    CloseButtonText="Close"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="12" Width="640">
        <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="13"
                   Text="Speak or type what you want done - several steps joined with 'and', 'then' or pauses. It's translated to exact CLI below, and nothing is sent until you press Send (or turn on hands-free)." />

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="VendorBox" Header="Device type" HorizontalAlignment="Stretch" SelectionChanged="Refresh" />
            <CheckBox x:Name="HandsFreeBox" Grid.Column="1" VerticalAlignment="Bottom" Content="Hands-free: send each instruction as I finish speaking"
                      Click="HandsFree_Click" />
        </Grid>

        <!-- Big mic + transcript -->
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="MicButton" Width="64" Height="64" CornerRadius="32" Click="MicButton_Click" VerticalAlignment="Top"
                    Background="{StaticResource OmlOrangeSubtleBrush}" BorderBrush="{StaticResource OmlOrangeBorderBrush}"
                    ToolTipService.ToolTip="Start listening" AutomationProperties.Name="Start listening">
                <FontIcon x:Name="MicIcon" Glyph="&#xE720;" FontSize="24" Foreground="{StaticResource OmlOrangeBrush}" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBox x:Name="PhraseBox" AcceptsReturn="False" TextChanged="Refresh" FontSize="15"
                         PlaceholderText="e.g.  configure terminal, interface gi0/0, ip address 10.0.0.1/24, no shut"
                         AutomationProperties.Name="Command" />
                <TextBlock x:Name="ListeningText" FontSize="12" Foreground="{StaticResource OmlSkyBrush}" Text="Click the mic to talk, or type above." TextWrapping="Wrap" />
                <Grid x:Name="MeterRow" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MIC" FontSize="10" FontWeight="Bold" Opacity="0.6" VerticalAlignment="Center" />
                    <ProgressBar x:Name="LevelMeter" Grid.Column="1" Maximum="1" Height="6" VerticalAlignment="Center"
                                 AutomationProperties.Name="Microphone level" />
                </Grid>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="ModelBar" Severity="Informational" IsOpen="False" IsClosable="True"
                 Title="Get much better recognition"
                 Message="Download the offline Whisper speech model (148 MB, one time). It understands accents and network terms far better than Windows' built-in recognizer, and still runs entirely on this PC.">
            <InfoBar.Content>
                <ProgressBar x:Name="ModelProgress" Maximum="1" Visibility="Collapsed" Margin="0,0,0,12" />
            </InfoBar.Content>
            <InfoBar.ActionButton>
                <Button x:Name="ModelButton" Content="Download model" Click="DownloadModel_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <InfoBar x:Name="MicErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />
        <InfoBar x:Name="EngineBar" Severity="Informational" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton>
                <HyperlinkButton x:Name="OnlineSpeechLink" Content="Turn on online speech (more accurate)" Click="OnlineSpeechLink_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <TextBlock Text="WILL SEND" Style="{StaticResource SectionLabelStyle}" />
        <Border CornerRadius="{StaticResource CardRadius}" Background="{StaticResource TerminalBackgroundBrush}" Padding="12,8"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
            <Grid>
                <ListView x:Name="PreviewList" MaxHeight="260" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Text="Nothing yet - speak or type an instruction." Opacity="0.5" Margin="0,6" />
            </Grid>
        </Border>
        <InfoBar x:Name="IncompleteBar" Severity="Warning" IsOpen="False" IsClosable="False" Title="Not fully understood" />
        <TextBlock x:Name="SentText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" />
    </StackPanel>
</ContentDialog>
