<UserControl
    x:Class="OmlTerminal.App.Views.OmlLabTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmlTerminal.App.Views">

    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="LabTitle" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandGradientBrush}" />
                <TextBlock x:Name="LabHostText" Opacity="0.55" FontSize="12" FontFamily="{StaticResource MonoFont}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="ConnectAllButton" Content="Connect All Online" Style="{StaticResource AccentButtonStyle}" Click="ConnectAll_Click" IsEnabled="False" />
            <Button Grid.Column="2" Click="Refresh_Click" ToolTipService.ToolTip="Refresh now">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <ProgressRing x:Name="Busy" IsActive="True" Width="14" Height="14" />
            <TextBlock x:Name="StatusText" Text="Loading nodes..." Opacity="0.65" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />
            <Border x:Name="TrustPanel" Visibility="Collapsed" CornerRadius="{StaticResource CardRadius}" Padding="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource OmlOrangeBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="TrustTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="TrustDetail" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Opacity="0.8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Trust and continue" Click="TrustAndRetry_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Cancel" Click="TrustCancel_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <ListView Grid.Row="3" x:Name="NodeList" SelectionMode="None" DoubleTapped="NodeList_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:OmlLabNodeView">
                    <Grid ColumnSpacing="14" Padding="6,10" Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="9" Height="9" Fill="{x:Bind StatusColor, Mode=OneWay}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Name}" />
                            <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Opacity="0.55" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ConsoleLabel}" Style="{StaticResource BadgeTextStyle}" />
                        </Border>
                        <TextBlock Grid.Column="3" Text="{x:Bind Status, Mode=OneWay}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
